<?xml version="1.0" encoding="UTF-8"?>
<databaseChangeLog
        xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
        xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:schemaLocation="http://www.liquibase.org/xml/ns/dbchangelog
    http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-4.3.xsd">

    <changeSet id="create-matches-table" author="matchmate-team">

        <createTable tableName="matches">

            <column name="match_id" type="BIGSERIAL">
                <constraints primaryKey="true" nullable="false"/>
            </column>

            <column name="event_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_matches_event"
                             references="events(event_id)"/>
            </column>

            <column name="user_a_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_matches_user_a"
                             references="users(user_id)"/>
            </column>

            <column name="user_b_id" type="BIGINT">
                <constraints nullable="false"
                             foreignKeyName="fk_matches_user_b"
                             references="users(user_id)"/>
            </column>

            <column name="score" type="INTEGER">
                <constraints nullable="false"/>
            </column>

            <column name="status" type="VARCHAR(20)">
                <constraints nullable="false"/>
            </column>

            <column name="created_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

            <column name="updated_at" type="TIMESTAMP" defaultValueDate="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>

        </createTable>

        <createIndex indexName="idx_matches_event_id" tableName="matches">
            <column name="event_id"/>
        </createIndex>

        <createIndex indexName="idx_matches_status" tableName="matches">
            <column name="status"/>
        </createIndex>

    </changeSet>

</databaseChangeLog>
